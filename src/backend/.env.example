# sisRUA Environment Configuration Example
# Copy this file to .env and fill in the values

# Security (Required for handshake)
SISRUA_AUTH_TOKEN=generate_a_secure_token_here

# AI Service (Optional - Groq)
GROQ_API_KEY=gsk_your_key_here

# GIS / Elevation (Optional - OpenTopography)
OPENTOPOGRAPHY_API_KEY=your_opentopo_key_here

# Infrastructure
ENVIRONMENT=dev
SENTRY_DSN=

# Paths (usually handled by OS, but can be overridden)
# LOCALAPPDATA=C:\Users\username\AppData\Local
